library(tidyverse)
data(iris)
summary(iris)
model <- lm(Sepal.Length ~ Sepal.Width + Petal.Length, data = iris)
summary(model)
anova(model)
plot(model)
predict(model, newdata = data.frame(Sepal.Width = 3.0, Petal.Length = 4.5))
table(iris$Species)
iris %>% group_by(Species) %>% summarise(mean_sl = mean(Sepal.Length))
ggplot(iris, aes(x = Petal.Length, y = Sepal.Length, color = Species)) + geom_point()
hist(iris$Sepal.Length, breaks = 20, main = "Sepal Length Distribution")
cor(iris[, 1:4])
saveRDS(model, "iris_model.rds")
q()
