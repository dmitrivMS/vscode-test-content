# ~/.bash_login - executed for login shells

# Source the shared profile if it exists
if [ -f "$HOME/.bash_profile" ]; then
    . "$HOME/.bash_profile"
fi

# Set default editor
export EDITOR="vim"
export VISUAL="vim"

# Load SSH agent if not already running
if [ -z "$SSH_AUTH_SOCK" ]; then
    eval "$(ssh-agent -s)" > /dev/null 2>&1
    ssh-add "$HOME/.ssh/id_ed25519" 2>/dev/null
fi

# Display last login info
echo "Welcome back, $USER. Last login was:"
last -1 "$USER" | head -1
