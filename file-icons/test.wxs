<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="My Application" Version="2.1.0" Manufacturer="Contoso Ltd."
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="My Application">
        <Component Id="MainExecutable" Guid="12345678-1111-2222-3333-444455556666">
          <File Source="$(var.BuildDir)\myapp.exe" KeyPath="yes" />
          <ServiceInstall Id="MyAppService" Name="MyAppSvc" DisplayName="My App Service"
                          Start="auto" Type="ownProcess" ErrorControl="normal" />
          <ServiceControl Id="StartMyAppService" Name="MyAppSvc" Start="install" Stop="both"
                          Remove="uninstall" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="Main Application" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>
  </Package>
</Wix>
